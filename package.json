{
  "name": "markitdown",
  "displayName": "MarkItDown",
  "description": "Because someone had to save your markdown files.",
  "version": "0.0.1",
  "publisher": "KaalaAadmi",
  "icon": "media/icon.png",
  "repository": { "type": "git", "url": "https://github.com/KaalaAadmi/markitdown" },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "readmeEditor.wysiwyg",
        "displayName": "README WYSIWYG Editor",
        "selector": [
          { "filenamePattern": "*.md" },
          { "filenamePattern": "*.markdown" }
        ],
        "priority": "option"
      }
    ],
    "configurationDefaults": {
      "workbench.editorAssociations": {
        "*.md": "readmeEditor.wysiwyg",
        "*.markdown": "readmeEditor.wysiwyg"
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
