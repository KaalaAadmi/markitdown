{
  "name": "HashDown",
  "displayName": "HashDown Editor",
  "description": "Because someone had to save your markdown files.",
  "version": "0.0.3",
  "publisher": "KaalaAadmi",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/KaalaAadmi/markitdown"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "license": "MIT",
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "markdown",
    "wysiwyg",
    "editor",
    "readme",
    "notion"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "readmeEditor.wysiwyg",
        "displayName": "MarkItDown WYSIWYG Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
